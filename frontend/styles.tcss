#startup-title, #welcome-title {
    text-style: bold;
    padding: 1 0;
}

#username {
    width: 40;
}

#menu-user {
    text-style: bold;
    padding: 0 0 1 0;
}

#menu-list {
    width: 44;
    height: auto;
}

#menu-help {
    padding: 1 0 0 0;
}

.menu-group {
    color: $text-muted;
    padding: 1 0 0 0;
}

.menu-item {
    padding: 0 2;
}

.menu-hover {
    background: $boost;
    text-style: bold;
}

#instruction-body, #profile-body, #wrong-body, #result-body {
    padding: 1 3;
}

#quiz-header {
    height: 1;
    padding: 0 1;
}

#quiz-title {
    text-style: bold;
    width: 1fr;
}

#quiz-timer {
    text-align: right;
}

#quiz-progress {
    padding: 1 1 0 1;
    color: $text-muted;
}

#quiz-question {
    padding: 1 2;
}

#quiz-options {
    padding: 0 2;
}

#quiz-help {
    dock: bottom;
    padding: 0 1;
}

SubmitConfirm {
    align: center middle;
}

#confirm-box {
    width: 60;
    height: auto;
    padding: 1 2;
    border: round $primary;
    background: $surface;
}

#confirm-buttons {
    height: auto;
    padding: 1 0 0 0;
    align-horizontal: center;
}

#confirm-yes, #confirm-no {
    width: auto;
    margin: 0 2;
}

.confirm-hover {
    background: $boost;
    text-style: bold reverse;
}
